@host = http://localhost:5234

### 1. Listar todos los usuarios
GET {{host}}/api/usuarios
Accept: application/json

### 2. Crear un usuario
POST {{host}}/api/usuarios
Content-Type: application/json

{
  "email": "vic@ejemplo.com",
  "password": "Gasolina2026",
  "estado": "activo"
}

### 3. Obtener un usuario por id
GET {{host}}/api/usuarios/1
Accept: application/json

### 4. Actualizar un usuario
PUT {{host}}/api/usuarios/1
Content-Type: application/json

{
  "email": "vic.nuevo@ejemplo.com",
  "estado": "inactivo"
}

### 5. Probar conflicto (409): email repetido
POST {{host}}/api/usuarios
Content-Type: application/json

{
  "email": "vic.nuevo@ejemplo.com",
  "password": "OtraClave123",
  "estado": "activo"
}

### 6. Probar validación (400): email inválido
POST {{host}}/api/usuarios
Content-Type: application/json

{
  "email": "esto-no-es-email",
  "password": "Gasolina2026",
  "estado": "activo"
}

### 7. Eliminar un usuario
DELETE {{host}}/api/usuarios/1

### 8. Probar no encontrado (404)
GET {{host}}/api/usuarios/1
Accept: application/json


# =========================== ROLES ===========================

### R1. Listar todos los roles
GET {{host}}/api/roles
Accept: application/json

### R2. Crear un rol
POST {{host}}/api/roles
Content-Type: application/json

{
  "nombre": "Operador",
  "descripcion": "Registra viajes y cargas de combustible",
  "activo": true
}

### R3. Obtener un rol por id
GET {{host}}/api/roles/1
Accept: application/json

### R4. Actualizar un rol
PUT {{host}}/api/roles/1
Content-Type: application/json

{
  "nombre": "Operador",
  "descripcion": "Usa vehículos de la empresa",
  "activo": false
}

### R5. Probar conflicto (409): nombre repetido
POST {{host}}/api/roles
Content-Type: application/json

{
  "nombre": "Operador",
  "activo": true
}

### R6. Probar validación (400): nombre vacío
POST {{host}}/api/roles
Content-Type: application/json

{
  "nombre": "",
  "activo": true
}

### R7. Eliminar un rol
DELETE {{host}}/api/roles/1

### R8. Probar no encontrado (404)
GET {{host}}/api/roles/1
Accept: application/json


