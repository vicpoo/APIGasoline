<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\APIGasoline.Application\APIGasoline.Application.csproj" />
    <ProjectReference Include="..\APIGasoline.Domain\APIGasoline.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IHostedService, ILogger, etc. (MinioBucketInitializer) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.12" />
    <!-- JWT: generar (Infrastructure) y validar (API, lo recibe por referencia) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Almacenamiento de archivos (SDK oficial de MinIO, compatible con S3) -->
    <PackageReference Include="Minio" Version="6.0.5" />
    <!-- Reportes de la flota: PDF (PDFsharp-MigraDoc) y Excel (ClosedXML). Ambas con licencia MIT -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tipografía de la app (Poppins) para los PDF: el contenedor Linux no trae fuentes -->
    <EmbeddedResource Include="Reportes\Fuentes\*.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
