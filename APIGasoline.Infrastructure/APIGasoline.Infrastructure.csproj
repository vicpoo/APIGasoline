<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\APIGasoline.Application\APIGasoline.Application.csproj" />
    <ProjectReference Include="..\APIGasoline.Domain\APIGasoline.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IHostedService, ILogger, etc. (MinioBucketInitializer) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- JWT: generar (Infrastructure) y validar (API, lo recibe por referencia) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Almacenamiento de archivos (SDK oficial de MinIO, compatible con S3) -->
    <PackageReference Include="Minio" Version="6.0.5" />
    <!-- Reportes de la flota: PDF (PDFsharp-MigraDoc) y Excel (ClosedXML). Ambas con licencia MIT -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- N005: fija la dependencia transitiva (SqlClient trae 9.0.11, PDFsharp 8.0.1) en una versión
         sin GHSA-846f-f764-76mx ni GHSA-2fmv-rv2c-59x7. Quitar cuando SqlClient y PDFsharp la traigan corregida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tipografía de la app (Poppins) para los PDF: el contenedor Linux no trae fuentes -->
    <EmbeddedResource Include="Reportes\Fuentes\*.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
