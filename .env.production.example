# ============================================================
#  Variables de PRODUCCIÓN (en el servidor EC2 se copia como ".env")
#  NUNCA subas el .env real al repositorio.
# ============================================================

# ---------- SQL Server ----------
# Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo (si no, el contenedor no arranca)
MSSQL_SA_PASSWORD=Pon_Una_Password_Larga_Y_Segura1
MSSQL_DATABASE=apigasoline
# Express (gratis, por defecto) | Standard | Enterprise (requieren licencia)
MSSQL_PID=Express

# ---------- MinIO ----------
MINIO_ROOT_USER=apigasoline_admin
MINIO_ROOT_PASSWORD=pon_otra_password_larga_min_8
MINIO_BUCKET=apigasoline
# "auto" usa la IP/dominio con que llaman a la API. También puedes fijarlo: 3.140.10.20:9000
MINIO_PUBLIC_ENDPOINT=auto

# ---------- JWT (mínimo 32 caracteres; genera una con: openssl rand -base64 48) ----------
JWT_KEY=cambia_esto_por_una_llave_de_al_menos_32_caracteres

# ---------- Usuario administrador inicial ----------
ADMIN_EMAIL=admin@gasoline.local
ADMIN_PASSWORD=cambia_esta_password

# ---------- Notificaciones push ----------
# NoOp = desactivadas. Firebase = requiere secrets/apigasoline-firebase.json en el servidor
PUSH_PROVEEDOR=NoOp

# ---------- Puerto público de la API ----------
API_PORT=80
