# Copia este archivo como ".env" y llena los valores.
# El archivo .env NO se sube al repositorio.

# ---------- SQL Server ----------
# Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo (si no, el contenedor no arranca)
MSSQL_SA_PASSWORD=Cambia_Esta_Password1
MSSQL_PORT=1433

# ---------- MinIO ----------
# Usuario y password de administrador (el password debe tener al menos 8 caracteres)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia_esta_password
MINIO_BUCKET=apigasoline
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
