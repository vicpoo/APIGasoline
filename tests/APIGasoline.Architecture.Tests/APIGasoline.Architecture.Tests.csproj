<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de arquitectura: revisan por reflexión (sin base de datos ni Docker) que el código
    respete las reglas del proyecto: capas, Commands/Queries sealed, un handler por request,
    que las Queries solo lean y que los controladores solo hablen con MediatR.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los controladores heredan de ControllerBase (ASP.NET Core) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\APIGasoline\APIGasoline.csproj" />
  </ItemGroup>

</Project>
